<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Multi-targeted for the same reason as NBA.Capture (see its csproj): the app itself, and the Fake*
      capture backend, build and run fine anywhere Avalonia does, but the real Windows.Graphics.Capture
      backend is only available/referenceable under the Windows TFM. Services/CapturePlatform.*.cs picks the
      right one per TFM (see that file) so App.axaml.cs stays platform-agnostic.
    -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    App.axaml.cs looks for model files under <output>/models/ (GetModelsDirectory). The repo's models/ lives
    at the solution root, not under this project, so copy its contents into the output directory rather than
    hardcoding an absolute/relative-to-source-tree path - keeps `dotnet run`/a published build both work the
    same way. PreserveNewest avoids re-copying the large .onnx files (100s of MB) on every unchanged build.
  -->
  <ItemGroup>
    <None Include="..\..\models\*.onnx;..\..\models\*.json" CopyToOutputDirectory="PreserveNewest" Link="models\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <Compile Remove="Services/CapturePlatform.Fallback.cs" />
    <Compile Remove="Services/ScoreboardOcrPlatform.Fallback.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows10.0.19041.0'">
    <Compile Remove="Services/CapturePlatform.Windows.cs" />
    <Compile Remove="Services/ScoreboardOcrPlatform.Windows.cs" />
  </ItemGroup>

  <!--
    Mac/MacVisionOcrEngine.cs compiles its Swift helper from source on first use (see that file) rather than at
    `dotnet build` time, but the source still needs to ship next to the app - same reasoning as the .onnx models
    copy below.
  -->
  <ItemGroup>
    <None Include="..\NBA.OCR\Mac\SwiftTool\main.swift" CopyToOutputDirectory="PreserveNewest" Link="native\mac-ocr\main.swift" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBA.Capture\NBA.Capture.csproj" />
    <ProjectReference Include="..\NBA.Inference\NBA.Inference.csproj" />
    <ProjectReference Include="..\NBA.Vision\NBA.Vision.csproj" />
    <ProjectReference Include="..\NBA.OCR\NBA.OCR.csproj" />
    <ProjectReference Include="..\NBA.State\NBA.State.csproj" />
  </ItemGroup>
</Project>
