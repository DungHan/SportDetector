<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NBA.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NBA.App.Views.RawOverlayView"
             x:DataType="vm:RawOverlayViewModel"
             x:Name="Root"
             IsVisible="{Binding IsVisible}">

    <Grid Background="#101010">
        <Image Source="{Binding CurrentFrame}" Stretch="Uniform" />

        <!--
            The overlay must scale/center exactly the way the Image above does, or annotation coordinates
            (computed in the captured frame's native pixel space) land outside the visible, scaled-down
            picture. Sizing this inner Canvas to the frame's actual pixel dimensions and letting the Viewbox
            apply the same Stretch="Uniform" fit makes both layers share one coordinate space.
        -->
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="OverlayCanvas">
                <ItemsControl ItemsSource="{Binding Visuals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <!-- Court keypoints (StyleKey="keypoint") get a bold X so they read clearly against
                                     the video; everything else (player boxes) keeps the plain dot marker. -->
                                <Path Data="M -8,-8 L 8,8 M 8,-8 L -8,8"
                                      Stroke="#FF0000" StrokeThickness="4" StrokeLineCap="Round"
                                      Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                      IsVisible="{Binding StyleKey, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=keypoint}" />
                                <Ellipse Width="10" Height="10" Fill="#FF4040"
                                         Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                         RenderTransform="translate(-5px,-5px)"
                                         IsVisible="{Binding StyleKey, Converter={x:Static conv:ObjectConverters.NotEqual}, ConverterParameter=keypoint}" />
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11"
                                           Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                           RenderTransform="translate(6px,-16px)" />
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Viewbox>
    </Grid>

</UserControl>
