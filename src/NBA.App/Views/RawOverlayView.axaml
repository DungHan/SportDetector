<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NBA.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NBA.App.Views.RawOverlayView"
             x:DataType="vm:RawOverlayViewModel"
             x:Name="Root"
             IsVisible="{Binding IsVisible}">

    <Grid Background="#101010">
        <Image Source="{Binding CurrentFrame}" Stretch="Uniform" />

        <!--
            The overlay must scale/center exactly the way the Image above does, or annotation coordinates
            (computed in the captured frame's native pixel space) land outside the visible, scaled-down
            picture. Sizing this inner Canvas to the frame's actual pixel dimensions and letting the Viewbox
            apply the same Stretch="Uniform" fit makes both layers share one coordinate space.

            Annotations are rendered by hand in RawOverlayView.axaml.cs, not via an ItemsControl bound to
            Visuals: an ItemsControl whose Canvas ItemsPanel positions each generated ContentPresenter through
            a Style-bound Canvas.Left/Top produced presenters with entirely correct Bounds/IsVisible/Opacity
            at every level (verified by dumping the live visual tree) that nevertheless never painted a single
            pixel on screen, while plain, direct Canvas children painted fine - an Avalonia 12.1.2 rendering
            bug specific to that ItemsControl+ContentPresenter+Style combination, not a layout or visibility
            bug. Manually adding/positioning shapes as direct Canvas children sidesteps it.
        -->
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="OverlayCanvas" />
        </Viewbox>
    </Grid>

</UserControl>
