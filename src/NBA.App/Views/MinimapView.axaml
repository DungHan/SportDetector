<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NBA.App.ViewModels"
             xmlns:conv="using:NBA.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="260"
             x:Class="NBA.App.Views.MinimapView"
             x:DataType="vm:MinimapViewModel"
             IsVisible="{Binding IsVisible}">

    <UserControl.Resources>
        <conv:MarkerStyleToBrushConverter x:Key="MarkerStyleToBrushConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto" Background="#182018">

        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- OpenCV-rendered court/field diagram for the current sport, sized to its real dimensions (meters * PixelsPerMeter). -->
            <Image Source="{Binding CourtDiagramBitmap}"
                   Width="{Binding CourtWidthPixels}" Height="{Binding CourtHeightPixels}" />

            <TextBlock Text="Calibrate to project markers on the diagram"
                       Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasValidCalibration}" />

            <Canvas Width="{Binding CourtWidthPixels}" Height="{Binding CourtHeightPixels}"
                    IsVisible="{Binding HasValidCalibration}">
                <ItemsControl ItemsSource="{Binding MarkerVisuals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding StyleKey, Converter={StaticResource MarkerStyleToBrushConverter}}"
                                         Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                         RenderTransform="translate(-5px,-5px)" />
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Grid>

        <!-- Reserved status/info panel region - placeholder text until Phase 4 (score/state) connects a real data source. -->
        <Border Grid.Row="1" Background="#101410" Padding="8">
            <TextBlock Text="{Binding StatusText}" Foreground="White" HorizontalAlignment="Center" />
        </Border>

    </Grid>

</UserControl>
